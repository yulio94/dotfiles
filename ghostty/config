# Matches the nvim colorscheme. Pinned dark, so it ignores the macOS appearance.
theme = "Iceberg Dark"

# Same font kitty.conf uses. Nerd Font, so NERDTree devicons render.
font-family = "MesloLGS NF"
font-size = 15

adjust-cell-height = 10%
window-padding-x = 4
window-padding-y = 4

macos-option-as-alt = true

# Every window attaches to one "main" session. resurrect/continuum keep it alive.
command = /opt/homebrew/bin/tmux new -A -s main

# Agents ping on finish/permission. Bounce the dock and badge the title.
desktop-notifications = true
bell-features = system,attention,title

# Agents copy via OSC 52. Ask, so terminal output can't swap the clipboard silently.
clipboard-write = ask
copy-on-select = clipboard

# Drop-down terminal for a quick one-off prompt.
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top

background-opacity = 0.92
background-blur = 20
